# 数据库配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=seat_navigation

# Flask
SECRET_KEY=your-secret-key-here
DEBUG=True

# Redis（可选）
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_DB=0

# CORS（生产环境限制来源）
# CORS_ORIGINS=https://yourdomain.com

# ==================== 大模型 AI（外接 API，OpenAI 兼容协议） ====================
# 说明：本项目所有 AI 功能均可切换模型供应商；未配置 API Key 时全部功能
#      自动降级为规则文案，系统仍可正常使用（不会报错、不会白屏）。
#
# AI_ENABLED=true             # 总开关；false 则完全走规则文案
# AI_PROVIDER=deepseek        # 预设：deepseek / openai / qwen / zhipu；也可用 custom
# AI_API_KEY=sk-xxxxxxxx      # 【必填】密钥，切勿提交到仓库（.env 已被 .gitignore 忽略）
# AI_MODEL=deepseek-chat      # 不填则用供应商预设默认模型
# AI_BASE_URL=                # 不填则用供应商预设地址；custom 时必须显式指定
# AI_TIMEOUT=20               # 单次请求超时（秒）
# AI_MAX_RETRIES=2            # 失败重试次数
# AI_MAX_TOKENS=600           # 单次生成上限（控成本）
# AI_TEMPERATURE=0.3
# AI_CACHE_TTL=60             # 相同请求缓存秒数，防重复调用
#
# 也可直接用供应商同名变量提供密钥（二选一）：
# DEEPSEEK_API_KEY=sk-xxxxxxxx

